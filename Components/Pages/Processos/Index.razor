@page "/processos"
@using appwebElizeu.Model
@using appwebElizeu.DAO
@inject ProcessoDAO ProcessoDAO

<PageTitle> Processos - Sistema de Controle de Processos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
	<div>
		<h2 class="fw-bold mb-1">Consulta de Processos</h2>
	</div>

	<div>
		<a href="/processos/cadastro" class="btn btn-primary">
			<i class="bi bi-plus-lg"></i>
			Novo Processo
		</a>
	</div>
</div>

<div class="custom-table-card">
	<div class="table-responsive">

		<table class="table align-middle">

			<thead>
				<tr>
					<th>Id</th>
					<th>Número</th>
					<th>Interessado</th>
					<th>Assunto</th>
					<th>Situação</th>
					<th>Ações</th>
				</tr>
			</thead>
			<tbody>
				
				@foreach (var processo in processos)
				{
					<tr>
						<td>@processo.Id</td>
						<td>@processo.Numero</td>
						<td>@processo.Interessado</td>
						<td>@processo.Assunto</td>
						<td>@processo.Situacao</td>
						<td></td>
					</tr>
				}
			</tbody>

		</table>

	</div>
</div>

<h3>Processos</h3>

@code {

	private List<Processos> processos = new();

	protected override void OnInitialized()
	{
		processos = ProcessoDAO.Listar();
	}
}
